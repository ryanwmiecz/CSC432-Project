# Auth0 Configuration (Optional)
# If these are provided, the app will use Auth0 as a database backend
# If not provided, the app will fall back to the local userStore system

# Your Auth0 domain (e.g., your-tenant.auth0.com)
VITE_AUTH0_DOMAIN=your-auth0-domain.auth0.com

# Your Auth0 Client ID  
VITE_AUTH0_CLIENT_ID=your_auth0_client_id_here

# Note: You must enable "Password" grant type in Auth0 Dashboard
# Go to Applications → Your App → Advanced Settings → Grant Types
# Enable "Password" checkbox

# Firebase Configuration
# Get these values from Firebase Console > Project Settings > Your Apps > SDK setup and configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
