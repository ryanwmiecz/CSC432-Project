// Example: Updated App.jsx with Firestore integration
// This is a reference file showing how to integrate Firestore into your chatroom

import React, { useState, useEffect, useRef } from "react";
import { useNavigate } from 'react-router-dom';
import { useAuth0 } from '@auth0/auth0-react';
import "./App.css";

// Import Firestore services
import { useMessages } from '../firebase/hooks';
import { createMessage, updateMessage, deleteMessage } from '../firebase/firestoreService';
import { formatTimestamp } from '../firebase/firestoreService';

// Helper component for displaying messages
const ChatMessage = ({ m, myData, onDelete, onEdit }) => {
  const isMine = m.userId === myData.id;

  return (
    <div className={`message ${isMine ? "sent" : "received"}`}>
      <div className="sender">{m.userName}</div>
      {m.attachment ? (
        <div className="message-content attachment-container">
          <p className="attachment-type">🖼️ Image Attachment</p>
          <div className="image-placeholder">
            {m.attachment.url ? (
              <img src={m.attachment.url} alt="attachment" style={{ maxWidth: '300px' }} />
            ) : (
              <p>Image not loaded</p>
            )}
          </div>
          {m.text && <p className="image-caption">{m.text}</p>}
        </div>
      ) : (
        <div className="message-content">{m.text}</div>
      )}
      <span className="timestamp">
        {m.createdAt && formatTimestamp(m.createdAt)}
        {m.isEdited && <span style={{ marginLeft: '5px', fontSize: '0.8em' }}>(edited)</span>}
      </span>
      
      {/* Show edit/delete buttons only for own messages */}
      {isMine && (
        <div className="message-actions">
          <button onClick={() => onEdit(m)}>Edit</button>
          <button onClick={() => onDelete(m.id)}>Delete</button>
        </div>
      )}
    </div>
  );
};

export default function App() {
  const navigate = useNavigate();
  const [inputMsg, setInputMsg] = useState("");
  const [editingMessage, setEditingMessage] = useState(null);
  const messagesEndRef = useRef(null);
  
  // Use the custom hook to get real-time messages
  const { messages, loading, error } = useMessages('default', 100);
  
  // Get current user (from Auth0 or local userStore)
  let currentUser = null;
  try {
    const auth0 = useAuth0();
    if (auth0.isAuthenticated) {
      currentUser = {
        id: auth0.user.sub,
        name: auth0.user.name || auth0.user.email,
        email: auth0.user.email,
      };
    }
  } catch (e) {
    // Fallback to local userStore
    if (window.userStore) {
      const user = window.userStore.getCurrentUser();
      if (user) {
        currentUser = {
          id: user.username,
          name: user.username,
        };
      }
    }
  }

  // Redirect to login if not authenticated
  useEffect(() => {
    if (!currentUser) {
      navigate('/login');
    }
  }, [currentUser, navigate]);

  // Auto-scroll to bottom when new messages arrive
  useEffect(() => {
    messagesEndRef.current?.scrollIntoView({ behavior: 'smooth' });
  }, [messages]);

  // Send or update message
  const handleSend = async () => {
    if (!inputMsg.trim() || !currentUser) return;

    try {
      if (editingMessage) {
        // Update existing message
        await updateMessage(editingMessage.id, {
          text: inputMsg,
          isEdited: true,
        });
        setEditingMessage(null);
      } else {
        // Create new message
        await createMessage({
          userId: currentUser.id,
          userName: currentUser.name,
          text: inputMsg,
          chatroomId: 'default',
          attachment: null,
        });
      }
      setInputMsg("");
    } catch (error) {
      console.error('Error sending message:', error);
      alert('Failed to send message. Please try again.');
    }
  };

  // Delete message
  const handleDelete = async (messageId) => {
    if (!window.confirm('Are you sure you want to delete this message?')) return;
    
    try {
      await deleteMessage(messageId);
    } catch (error) {
      console.error('Error deleting message:', error);
      alert('Failed to delete message. Please try again.');
    }
  };

  // Start editing a message
  const handleEdit = (message) => {
    setEditingMessage(message);
    setInputMsg(message.text);
  };

  // Cancel editing
  const handleCancelEdit = () => {
    setEditingMessage(null);
    setInputMsg("");
  };

  // Handle Enter key press
  const handleKeyPress = (e) => {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      handleSend();
    }
  };

  if (loading) {
    return <div className="loading">Loading messages...</div>;
  }

  if (error) {
    return <div className="error">Error loading messages: {error.message}</div>;
  }

  return (
    <div className="app-container">
      <header className="chat-header">
        <h1>Chatroom</h1>
        <div className="header-actions">
          <button onClick={() => navigate('/profile')}>Profile</button>
          <button onClick={() => {
            // Logout logic
            if (window.userStore) {
              window.userStore.removeCurrentUser();
            }
            navigate('/login');
          }}>
            Logout
          </button>
        </div>
      </header>

      <div className="messages-container">
        {messages.map((msg) => (
          <ChatMessage
            key={msg.id}
            m={msg}
            myData={currentUser}
            onDelete={handleDelete}
            onEdit={handleEdit}
          />
        ))}
        <div ref={messagesEndRef} />
      </div>

      <div className="input-container">
        {editingMessage && (
          <div className="editing-indicator">
            Editing message
            <button onClick={handleCancelEdit}>Cancel</button>
          </div>
        )}
        <div className="input-wrapper">
          <input
            type="text"
            value={inputMsg}
            onChange={(e) => setInputMsg(e.target.value)}
            onKeyPress={handleKeyPress}
            placeholder="Type a message..."
            className="message-input"
          />
          <button onClick={handleSend} className="send-button">
            {editingMessage ? 'Update' : 'Send'}
          </button>
        </div>
      </div>
    </div>
  );
}
